// use prisma-8

// prisma/schema.prisma
// Adopted from docs/DATABASE_DESIGN.md (spec 0001, Option 1).
// Full normalized data model for Cevo: identity, academic hierarchy,
// templates, projects, research sources, files, AI telemetry, billing,
// credits, payments, and audit events.

enum UserRole {
  STUDENT
  ADMIN
  SUPER_ADMIN
}

enum QualificationLevel {
  HND
  BACHELORS
  MASTERS
  PHD
  OTHER
}

enum ProjectType {
  APPLIED_SOFTWARE
  RESEARCH_ACADEMIC
}

enum ProjectStatus {
  DRAFT
  PLANNING
  IN_PROGRESS
  READY_FOR_REVIEW
  COMPLETED
  ARCHIVED
}

enum VerificationState {
  METADATA_VERIFIED
  DOI_VERIFIED
  FULL_TEXT_AVAILABLE
  REQUIRES_REVIEW
  INCOMPLETE_METADATA
}

enum FileCategory {
  GUIDELINE
  SUPERVISOR_NOTE
  FIGURE
  DATASET
  LITERATURE
  OTHER
}

enum ExportFormat {
  PDF
  DOCX
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum LedgerType {
  CREDIT_PURCHASE
  OPERATION_DEBIT
  PROMOTIONAL_CREDIT
  REFUND
  ADMIN_ADJUSTMENT
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  EXPIRED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum WizardSessionStatus {
  DRAFT
  CHATTING
  SYNTHESIZING
  AWAITING_APPROVAL
  APPROVED
  ABANDONED
  EXPIRED
}

enum WizardFieldKey {
  BACKGROUND
  PROBLEM
  AIM
  OBJECTIVES
  QUESTIONS
  SCOPE
  LIMITATIONS
  METHODOLOGY
  OUTCOMES
}

model User {
  id            String    @id @onCreate(cuid(2))
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(STUDENT)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @onCreate(now()) @onUpdate(now())

  sessions      Session[]
  accounts      Account[]
  studentProfile   StudentProfile?
  academicProfile  AcademicProfile?
  projects         Project[]
  creditWallet     CreditWallet?
  payments         Payment[]
  supportTickets   SupportTicket[]
  notifications    Notification[]
  auditEvents      AuditEvent[]
  wizardSessions   WizardSession[]
  fileAssets       FileAsset[]
}

model Session {
  id        String   @id @onCreate(cuid(2))
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @onCreate(now()) @onUpdate(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id           String    @id @onCreate(cuid(2))
  userId       String
  accountId    String
  providerId   String
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  password     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @onCreate(now()) @onUpdate(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @onCreate(cuid(2))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @onCreate(now()) @onUpdate(now())

  @@index([identifier])
  @@unique([identifier, value])
}

model StudentProfile {
  id                  String   @id @onCreate(cuid(2))
  userId              String   @unique
  firstName           String
  lastName            String
  preferredLanguage   String   @default("en")
  country             String   @default("Cameroon")
  onboardingCompleted Boolean  @default(false)
  onboardingStep      Int      @default(1)
  referralSource      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @onCreate(now()) @onUpdate(now())

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AcademicProfile {
  id                  String             @id @onCreate(cuid(2))
  userId              String             @unique
  institutionId       String?
  facultyId           String?
  departmentId        String?
  programmeId         String?
  customInstitution   String?
  customFaculty       String?
  customDepartment    String?
  qualification       QualificationLevel @default(BACHELORS)
  academicSession     String
  preferredStyle      String             @default("APA_7")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @onCreate(now()) @onUpdate(now())

  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution         Institution?       @relation(fields: [institutionId], references: [id])
  faculty             Faculty?           @relation(fields: [facultyId], references: [id])
  department          Department?        @relation(fields: [departmentId], references: [id])
  programme           Programme?         @relation(fields: [programmeId], references: [id])
}

model Institution {
  id          String      @id @onCreate(cuid(2))
  name        String      @unique
  code        String      @unique
  country     String      @default("Cameroon")
  city        String?
  logoUrl     String?
  isVerified  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @onCreate(now()) @onUpdate(now())

  faculties   Faculty[]
  templates   ProjectTemplate[]
  academicProfiles AcademicProfile[]
}

model Faculty {
  id            String       @id @onCreate(cuid(2))
  institutionId String
  name          String
  code          String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @onCreate(now()) @onUpdate(now())

  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  departments   Department[]
  templates     ProjectTemplate[]
  academicProfiles AcademicProfile[]

  @@unique([institutionId, name])
}

model Department {
  id          String       @id @onCreate(cuid(2))
  facultyId   String
  name        String
  code        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @onCreate(now()) @onUpdate(now())

  faculty     Faculty      @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  programmes  Programme[]
  templates   ProjectTemplate[]
  academicProfiles AcademicProfile[]

  @@unique([facultyId, name])
}

model Programme {
  id            String             @id @onCreate(cuid(2))
  departmentId  String
  name          String
  qualification QualificationLevel @default(BACHELORS)
  durationYears Int                @default(3)
  createdAt     DateTime           @default(now())
  updatedAt       DateTime           @onCreate(now()) @onUpdate(now())

  department    Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  templates     ProjectTemplate[]
  academicProfiles AcademicProfile[]

  @@unique([departmentId, name, qualification])
}

model ProjectTemplate {
  id            String              @id @onCreate(cuid(2))
  title         String
  description   String?
  institutionId String?
  facultyId     String?
  departmentId  String?
  programmeId   String?
  qualification QualificationLevel  @default(BACHELORS)
  projectType   ProjectType         @default(APPLIED_SOFTWARE)
  isOfficial    Boolean             @default(false)
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @onCreate(now()) @onUpdate(now())

  institution   Institution?        @relation(fields: [institutionId], references: [id])
  faculty       Faculty?            @relation(fields: [facultyId], references: [id])
  department    Department?         @relation(fields: [departmentId], references: [id])
  programme     Programme?          @relation(fields: [programmeId], references: [id])
  versions      TemplateVersion[]
  projects      Project[]
}

model TemplateVersion {
  id          String          @id @onCreate(cuid(2))
  templateId  String
  version     Int             @default(1)
  isPublished Boolean         @default(false)
  changelog   String?
  createdAt   DateTime        @default(now())
  publishedAt DateTime?

  template    ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  rules       TemplateRule?
  sections    TemplateSection[]
  projects    Project[]

  @@unique([templateId, version])
}

model TemplateRule {
  id                String          @id @onCreate(cuid(2))
  templateVersionId String          @unique
  pageSize          String          @default("A4")
  marginTopMm       Float           @default(25.4)
  marginBottomMm    Float           @default(25.4)
  marginLeftMm      Float           @default(38.1)
  marginRightMm     Float           @default(25.4)
  fontFamily        String          @default("Times New Roman")
  fontSizeBodyPt    Float           @default(12.0)
  lineSpacing       Float           @default(1.5)
  paragraphIndentMm Float           @default(12.7)
  heading1FontPt    Float           @default(16.0)
  heading1Style     String          @default("BOLD_UPPERCASE")
  heading2FontPt    Float           @default(14.0)
  heading2Style     String          @default("BOLD_TITLECASE")
  citationStyle     String          @default("APA_7")
  requirePrelims    Json
  createdAt         DateTime        @default(now())

  templateVersion   TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
}

model TemplateSection {
  id                String          @id @onCreate(cuid(2))
  templateVersionId String
  orderIndex        Int
  title             String
  sectionType       String
  description       String?
  requiredSubsections Json?
  createdAt         DateTime        @default(now())

  templateVersion   TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)

  @@index([templateVersionId, orderIndex])
}

model TemplateDraft {
  id           String   @id @onCreate(cuid(2))
  templateId   String?
  sourceText   Text?
  sourceFileId String?
  payload      Json?
  status       String   @default("open")
  createdBy    String
  createdAt    DateTime @default(now())

  template     ProjectTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model Project {
  id                String              @id @onCreate(cuid(2))
  userId            String
  templateId        String?
  templateVersionId String?
  title             String
  projectType       ProjectType         @default(APPLIED_SOFTWARE)
  qualification     QualificationLevel  @default(BACHELORS)
  programmeName     String?
  submissionDeadline DateTime?
  status            ProjectStatus       @default(PLANNING)
  progressPercent   Int                 @default(0)
  referencingStyle  String              @default("APA_7")
  isArchived        Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @onCreate(now()) @onUpdate(now())

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  template          ProjectTemplate?    @relation(fields: [templateId], references: [id])
  templateVersion   TemplateVersion?    @relation(fields: [templateVersionId], references: [id])

  brief             ProjectBrief?
  outline           ProjectOutline?
  sections          ProjectSection[]
  tasks             ProjectTask[]
  activities        ProjectActivity[]
  sources           ProjectSource[]
  files             FileAsset[]
  exportJobs        ExportJob[]
  wizardSessions    WizardSession[]
  reviewRuns        ReviewRun[]

  @@index([userId, status])
  @@index([userId, isArchived])
}

model ProjectBrief {
  id                String   @id @onCreate(cuid(2))
  projectId         String   @unique
  background        Text
  problemStatement  Text
  aim               Text
  objectives        Json
  researchQuestions Json
  scope             Text
  limitations       Text
  methodology       Text
  expectedOutcomes  Text
  targetEnvironment Text?
  isApproved        Boolean  @default(false)
  approvedAt        DateTime?
  version           Int      @default(1)
  modelId           String?
  synthesisCost     Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @onCreate(now()) @onUpdate(now())

  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions          BriefVersion[]
}

model ProjectOutline {
  id          String   @id @onCreate(cuid(2))
  projectId   String   @unique
  structure   Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @onCreate(now()) @onUpdate(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectSection {
  id          String   @id @onCreate(cuid(2))
  projectId   String
  parentId    String?
  orderIndex  Int
  title       String
  sectionType String   @default("CHAPTER")
  slug        String
  content     Json?
  wordCount   Int      @default(0)
  version     Int      @default(1)
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @onCreate(now()) @onUpdate(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent      ProjectSection?  @relation("SectionHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    ProjectSection[] @relation("SectionHierarchy")
  citations   Citation[]
  versions    DocumentVersion[]
  reviewWarnings ReviewWarning[]

  @@index([projectId, orderIndex])
  @@index([projectId, parentId])
}

model DocumentVersion {
  id          String         @id @onCreate(cuid(2))
  sectionId   String
  versionNumber Int
  content     Json
  wordCount   Int
  changeSummary String?
  createdAt   DateTime       @default(now())

  section     ProjectSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, versionNumber])
}

model ProjectTask {
  id          String    @id @onCreate(cuid(2))
  projectId   String
  title       String
  description String?
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  dueDate     DateTime?
  orderIndex  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @onCreate(now()) @onUpdate(now())

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, isCompleted])
}

model ProjectActivity {
  id          String   @id @onCreate(cuid(2))
  projectId   String
  action      String
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model ResearchSource {
  id                String            @id @onCreate(cuid(2))
  doi               String?           @unique
  openAlexId        String?           @unique
  semanticScholarId String?           @unique
  title             Text
  authors           Json
  publicationYear   Int?
  venue             String?
  volume            String?
  issue             String?
  pages             String?
  publisher         String?
  abstract          Text?
  pdfUrl            String?
  isOpenAccess      Boolean           @default(false)
  verificationState VerificationState @default(METADATA_VERIFIED)
  rawMetadata       Json?
  formattedApa      Text?
  formattedHarvard  Text?
  lastVerifiedAt    DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @onCreate(now()) @onUpdate(now())

  projectSources    ProjectSource[]
  citations         Citation[]

  @@index([title])
  @@index([publicationYear])
}

model ProjectSource {
  id          String         @id @onCreate(cuid(2))
  projectId   String
  sourceId    String
  studentNote Text?
  tags        Json?
  isPinned    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @onCreate(now()) @onUpdate(now())

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source      ResearchSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([projectId, sourceId])
}

model Citation {
  id            String         @id @onCreate(cuid(2))
  sectionId     String
  sourceId      String
  inlineText    String
  citationKey   String
  style         String         @default("APA_7")
  formattedText Text?
  anchorId      String?
  createdAt     DateTime       @default(now())

  section     ProjectSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  source      ResearchSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sectionId, sourceId])
  @@index([sectionId])
  @@index([sourceId])
  @@index([citationKey])
}

model ReviewRun {
  id                String   @id @onCreate(cuid(2))
  projectId         String
  templateVersionId String?
  status            String   @default("running")
  missingCount      Int      @default(0)
  uncitedCount      Int      @default(0)
  driftCount        Int      @default(0)
  formattingCount   Int      @default(0)
  skippedSemantic   Boolean  @default(false)
  skipReason        String?
  truncated         Boolean  @default(false)
  clientRunKey      String?
  createdBy         String
  createdAt         DateTime @default(now())

  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  warnings ReviewWarning[]

  @@unique([projectId, clientRunKey])
  @@index([projectId, createdAt])
}

model ReviewWarning {
  id             String   @id @onCreate(cuid(2))
  runId          String
  checkType      String
  severity       String   @default("warn")
  message        Text
  sectionId      String?
  blockIndex     Int?
  excerpt        String?
  sectionVersion Int?
  createdAt      DateTime @default(now())

  run     ReviewRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  section ProjectSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([runId, checkType])
}

model FileAsset {
  id               String       @id @onCreate(cuid(2))
  projectId        String
  uploadedByUserId String
  fileName         String
  fileSize         Int
  mimeType         String
  s3Key            String       @unique
  category         FileCategory @default(OTHER)
  checksumSha256   String?
  clientToken      String       @unique
  extractionStatus String       @default("PENDING")
  extractionError  String?
  extractedText    Text?
  isProcessed      Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @onCreate(now()) @onUpdate(now())

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader     User         @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@index([projectId, category])
  @@index([projectId, createdAt, id])
}

model ExportJob {
  id           String       @id @onCreate(cuid(2))
  projectId    String
  format       ExportFormat @default(PDF)
  status       JobStatus    @default(QUEUED)
  s3Key        String?
  fileSize     Int?
  errorMessage String?
  createdAt    DateTime     @default(now())
  completedAt  DateTime?

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}

model AiUsage {
  id            String   @id @onCreate(cuid(2))
  userId        String
  projectId     String?
  operationType String
  provider      String   @default("openrouter")
  modelName     String
  inputTokens   Int
  outputTokens  Int
  totalTokens   Int
  providerCostUsd Float
  creditsCharged  Int
  durationMs    Int
  status        String
  errorMessage  String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([operationType])
  @@index([modelName])
}

model OperationPricing {
  id            String   @id @onCreate(cuid(2))
  operationType String   @unique
  displayName   String
  creditCost    Int
  modelTier     String   @default("ECONOMICAL")
  defaultModel  String
  isActive      Boolean  @default(true)
  updatedAt     DateTime @onCreate(now()) @onUpdate(now())
}

model CreditWallet {
  id        String   @id @onCreate(cuid(2))
  userId    String   @unique
  balance   Int      @default(50)
  updatedAt DateTime @onCreate(now()) @onUpdate(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgers   CreditLedger[]
}

model CreditLedger {
  id          String     @id @onCreate(cuid(2))
  walletId    String
  type        LedgerType
  amount      Int
  balanceAfter Int
  description String
  referenceId String?
  metadata    Json?
  createdAt   DateTime   @default(now())

  wallet      CreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@unique([walletId, referenceId, type])
}

model CreditPackage {
  id          String   @id @onCreate(cuid(2))
  name        String
  priceXaf    Int
  credits     Int
  isPopular   Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @onCreate(now()) @onUpdate(now())

  payments    Payment[]
}

model Payment {
  id              String        @id @onCreate(cuid(2))
  userId          String
  packageId       String
  amountXaf       Int
  creditsAllocated Int
  status          PaymentStatus @default(PENDING)
  provider        String        @default("fapshi")
  providerTransId String?       @unique
  payerPhone      String?
  paymentUrl      String?
  failureReason   String?
  createdAt       DateTime      @default(now())
  completedAt     DateTime?

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  package         CreditPackage @relation(fields: [packageId], references: [id])
  webhookEvents   PaymentWebhookEvent[]

  @@index([userId, status])
  @@index([providerTransId])
}

model PaymentWebhookEvent {
  id          String   @id @onCreate(cuid(2))
  paymentId   String?
  eventType   String
  payload     Json
  isProcessed Boolean  @default(false)
  createdAt   DateTime @default(now())

  payment     Payment? @relation(fields: [paymentId], references: [id])
}

model Notification {
  id        String   @id @onCreate(cuid(2))
  userId    String
  title     String
  message   String
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model SupportTicket {
  id          String           @id @onCreate(cuid(2))
  userId      String
  subject     String
  category    String
  status      TicketStatus     @default(OPEN)
  priority    String           @default("NORMAL")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @onCreate(now()) @onUpdate(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    SupportMessage[]

  @@index([userId, status])
}

model SupportMessage {
  id        String        @id @onCreate(cuid(2))
  ticketId  String
  senderId  String
  isAdmin   Boolean       @default(false)
  message   Text
  createdAt DateTime      @default(now())

  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id         String   @id @onCreate(cuid(2))
  userId     String?
  action     String
  targetType String
  targetId   String
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id])

  @@index([action, createdAt])
  @@index([targetType, targetId])
}

model WizardSession {
  id                 String               @id @onCreate(cuid(2))
  userId             String
  projectId          String?
  currentStep        Int                  @default(1)
  status             WizardSessionStatus  @default(DRAFT)
  readiness          Json?
  suggestedTemplateId String?
  idempotencyKey     String               @unique
  approvalKey        String?              @unique
  expiresAt          DateTime
  currentBriefVersion Int                 @default(0)
  title              String?
  qualification      String?
  departmentName     String?
  programmeName      String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @onCreate(now()) @onUpdate(now())

  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  project            Project?             @relation(fields: [projectId], references: [id])
  turns              WizardTurn[]

  @@index([userId, status])
  @@index([userId, updatedAt])
}

model WizardTurn {
  id           String         @id @onCreate(cuid(2))
  sessionId    String
  fieldKey     WizardFieldKey
  promptText   Text
  answerText   Text
  followupText Text?
  isSufficient Boolean        @default(false)
  createdAt    DateTime       @default(now())

  session      WizardSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, fieldKey, createdAt])
}

model BriefVersion {
  id        String       @id @onCreate(cuid(2))
  briefId   String
  version   Int
  payload   Json
  modelId   String?
  tokenCost Int          @default(0)
  createdAt DateTime     @default(now())

  brief     ProjectBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)

  @@unique([briefId, version])
  @@index([briefId, version])
}

model AiAssistRun {
  id              String   @id @onCreate(cuid(2))
  projectId       String
  sectionId       String
  userId          String
  operation       String
  promptVersion   String
  scope           String
  sectionVersion  Int
  inputHash       String
  inputText       Text
  inputChars      Int
  estimateCredits Int
  actualCredits   Int      @default(0)
  modelId         String?
  tokenCost       Int      @default(0)
  status          String   @default("held")
  idempotencyKey  String   @unique
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  suggestions     AiSuggestion[]

  @@index([sectionId, createdAt])
  @@index([projectId, createdAt])
}

model AiSuggestion {
  id            String   @id @onCreate(cuid(2))
  runId         String
  paragraphIndex Int
  originalText  String
  revisedText   String
  warnings      Json?
  status        String   @default("pending")
  createdAt     DateTime @default(now())

  run           AiAssistRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, paragraphIndex])
  @@index([runId, paragraphIndex])
}
