# ==========================================
# Cevo Environment Configuration
# ==========================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (PostgreSQL)
DATABASE_URL="postgresql://cevo_user:cevo_pass@localhost:5432/cevo?schema=public"

# Authentication (Better Auth)
BETTER_AUTH_SECRET="change-this-to-a-secure-random-32-byte-hex-string"
BETTER_AUTH_URL="http://localhost:3000"

# AI Model Gateway (OpenRouter)
OPENROUTER_API_KEY=""
AI_DEFAULT_ECONOMICAL_MODEL="openai/gpt-4o-mini"
AI_DEFAULT_ADVANCED_MODEL="anthropic/claude-3.5-sonnet"

# Payment Gateway (Fapshi - Mobile Money in Cameroon)
FAPSHI_API_KEY=""
FAPSHI_API_USER=""
FAPSHI_BASE_URL="https://live.fapshi.com"
FAPSHI_WEBHOOK_SECRET=""

# Private S3-Compatible Storage
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET_NAME="cevo-private-assets"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Inngest Background Jobs
INNGEST_EVENT_KEY="local-dev-event-key"
INNGEST_SIGNING_KEY="local-dev-signing-key"

# Arcjet Rate Limiting & Bot Protection
ARCJET_KEY=""
