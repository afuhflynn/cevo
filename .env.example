# =============================================================================
# Cevo — Environment Variables
# =============================================================================
#
# Quick Start:
#   cp .env.example .env
#   # Then fill in your values below.
#
# For local development, the docker-compose.yml bundled with the repo starts a
# PostgreSQL database on port 5432. Run:
#   docker compose up -d
#
# A few variables have sensible dev defaults baked into the code; those are
# marked (OPTIONAL) below. Everything else is required for the app to boot.
#
# Legend:
#   [REQUIRED]  — App will crash or malfunction without a valid value
#   [OPTIONAL]  — Code provides a fallback; safe to leave as-is for dev
#   [PUBLIC]    — Exposed to the browser (must be safe to leak)
#
# =============================================================================


# =============================================================================
# NODE ENVIRONMENT
# =============================================================================

# [REQUIRED] Application runtime environment.
# Use "development" for local dev, "production" for deployed environments.
# In non-production mode Prisma enables query logging and connection pooling
# dev helpers (see lib/prisma.ts).
NODE_ENV="development"


# =============================================================================
# DATABASE — PostgreSQL (Prisma ORM)
# =============================================================================
#
# Where to get it:
#   LOCAL DEVELOPMENT:
#     The repo's docker-compose.yml runs PostgreSQL 15 on port 5432 with
#     db: cevo, user: cevo_user, password: cevo_pass. Start it with:
#       docker compose up -d
#   PRODUCTION:
#     Use a managed PostgreSQL instance (e.g. Neon, Supabase, Railway, RDS,
#     or your own server) and paste its connection string below.
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# =============================================================================

# [REQUIRED] PostgreSQL connection string used by Prisma ORM.
# The docker-compose default matches the value below.
DATABASE_URL="postgresql://cevo_user:cevo_pass@localhost:5432/cevo?schema=public"


# =============================================================================
# AUTHENTICATION — Better Auth
# =============================================================================
#
# Where to get it:
#   BETTER_AUTH_SECRET:
#     Generate a secure random 32-byte hex string, e.g.:
#       openssl rand -hex 32
#   BETTER_AUTH_URL:
#     The base URL of your app. For local dev: http://localhost:3000
#
# Used in: authentication (registration, email verification, password reset,
#          session cookies, role-guarded routes)
# =============================================================================

# [REQUIRED] Better Auth signing secret. Generate a secure random 32-byte hex
# string with `openssl rand -hex 32`. Change this in production.
BETTER_AUTH_SECRET="change-this-to-a-secure-random-32-byte-hex-string"

# [REQUIRED] Base URL of your application, used for auth callbacks and emails.
# For local dev: http://localhost:3000
BETTER_AUTH_URL="http://localhost:3000"


# =============================================================================
# EMAIL — SMTP (Nodemailer)
# =============================================================================
#
# Where to get it:
#   LOCAL DEVELOPMENT (default):
#     The repo's docker-compose.yml runs Mailpit on localhost:1025
#     (SMTP, no authentication) with a web UI on http://localhost:8025.
#     Start it with: docker compose up -d
#   PRODUCTION:
#     Use your transactional email provider's SMTP host, port, username,
#     and password (e.g. your own mail server or a hosted SMTP relay).
#
# Used in: lib/email.ts (Better Auth verification and password reset emails)
# =============================================================================

# [REQUIRED] SMTP host for verification and reset emails.
# For local dev (Mailpit): localhost
SMTP_HOST="localhost"

# [REQUIRED] SMTP port for verification and reset emails.
# For local dev (Mailpit): 1025
SMTP_PORT="1025"

# [OPTIONAL] SMTP username. Leave empty for local dev (Mailpit needs none).
SMTP_USER=""

# [OPTIONAL] SMTP password. Leave empty for local dev (Mailpit needs none).
SMTP_PASS=""

# [REQUIRED] Sender address and display name for auth emails.
SMTP_FROM="Cevo <no-reply@cevo.example>"

# [OPTIONAL] Support contact shown in the footer of auth emails.
# Falls back to SMTP_FROM when unset.
# SUPPORT_EMAIL="support@cevo.example"


# =============================================================================
# AI MODEL GATEWAY — OpenRouter
# =============================================================================
#
# Where to get it:
#   1. Go to https://openrouter.ai (sign up / log in)
#   2. Go to Settings → API Keys → Create key
#   3. Copy the key (starts with sk-or-v1-...)
#   Add a payment method and set a usage limit before the key works.
#
# Used in: lib/ai/* (Vercel AI SDK tiered model routing — Economical vs
#          Advanced reasoning models)
# =============================================================================

# [REQUIRED] OpenRouter API key for the AI model gateway.
OPENROUTER_API_KEY=""

# [OPTIONAL] Default economical (cheap/fast) model used for routine AI tasks.
AI_DEFAULT_ECONOMICAL_MODEL="openai/gpt-4o-mini"

# [OPTIONAL] Default advanced (reasoning) model used for complex AI tasks.
AI_DEFAULT_ADVANCED_MODEL="anthropic/claude-3.5-sonnet"

# [OPTIONAL] Pinned cheap draft snapshot for wizard brief synthesis.
OPENROUTER_DRAFT_MODEL="deepseek/deepseek-v4.1-flash-1017"

# [OPTIONAL] Pinned frontier review snapshot for wizard brief synthesis.
OPENROUTER_REVIEW_MODEL="anthropic/claude-sonnet-5.5"

# [OPTIONAL] Comma separated fallback slugs for OpenRouter routing failover.
OPENROUTER_FALLBACK_MODELS=""

# [OPTIONAL] Per user daily wizard synthesis cap.
WIZARD_SYNTHESIS_DAILY_CAP="10"

# [OPTIONAL] Pinned snapshot for template guideline extraction drafts.
OPENROUTER_EXTRACT_MODEL="deepseek/deepseek-v4.1-flash-1017"

# [OPTIONAL] Platform default template version id used when no match wins.
PLATFORM_DEFAULT_TEMPLATE_VERSION_ID=""

# [OPTIONAL] Per admin daily template extraction cap.
TEMPLATE_EXTRACT_DAILY_CAP="20"

# [OPTIONAL] Credit hold lifetime in minutes for wizard synthesis.
WIZARD_HOLD_EXPIRY_MINUTES="15"

# [OPTIONAL] Expiry window in days for abandoned wizard sessions.
WIZARD_SESSION_TTL_DAYS="30"


# =============================================================================
# PAYMENTS — Fapshi (Mobile Money in Cameroon)
# =============================================================================
#
# Where to get it:
#   1. Go to https://live.fapshi.com (or the Fapshi sandbox for testing)
#   2. Sign up / log in to your merchant dashboard
#   3. Generate an API key and API user from the dashboard
#   4. Set up a webhook endpoint pointing to:
#      http://localhost:3000/api/webhooks/fapshi (local dev)
#      https://your-domain.com/api/webhooks/fapshi (production)
#   5. Copy the webhook secret from the dashboard
#
# Supports MTN Mobile Money and Orange Money in XAF (FCFA).
# =============================================================================

# [REQUIRED] Fapshi API key for mobile money collections.
FAPSHI_API_KEY=""

# [REQUIRED] Fapshi API user (merchant identifier).
FAPSHI_API_USER=""

# [OPTIONAL] Fapshi base URL. Use https://live.fapshi.com for production,
# or the sandbox URL for testing.
FAPSHI_BASE_URL="https://live.fapshi.com"

# [REQUIRED] Webhook secret used to verify that incoming Fapshi webhook
# payloads are genuinely from Fapshi. Generate a random string and use the
# same value here and in the Fapshi dashboard webhook settings.
FAPSHI_WEBHOOK_SECRET=""


# =============================================================================
# OBJECT STORAGE — S3-Compatible Private Storage
# =============================================================================
#
# Where to get it:
#   1. Sign up for an S3-compatible storage provider (e.g. Cloudflare R2,
#      AWS S3, Minio self-hosted, etc.)
#   2. Create a bucket named cevo-private-assets (or your preferred name)
#   3. Generate access key / secret key credentials
#   4. Note the endpoint and region
#
# Used for: supervisor instructions, datasets, figures, guidelines — private
# buckets with short-lived presigned URLs and background text extraction.
# =============================================================================

# [REQUIRED] S3-compatible storage endpoint, e.g. https://account.r2.cloudflarestorage.com
S3_ENDPOINT=""

# [REQUIRED] S3 region. Use "auto" for Cloudflare R2.
S3_REGION="auto"

# [REQUIRED] Name of the private S3 bucket for Cevo assets.
S3_BUCKET_NAME="cevo-private-assets"

# [REQUIRED] S3 access key ID.
S3_ACCESS_KEY_ID=""

# [REQUIRED] S3 secret access key.
S3_SECRET_ACCESS_KEY=""


# =============================================================================
# BACKGROUND JOBS — Inngest
# =============================================================================
#
# Where to get it:
#   LOCAL DEVELOPMENT (default):
#     Use the dev keys below — no external account needed.
#   PRODUCTION (Inngest Cloud):
#     1. Go to https://app.inngest.com (sign up / log in)
#     2. Create a new project/app
#     3. Go to Settings → Keys
#     4. Copy the "Event Key" and "Signing Key"
#
# Used in: durable workflows for exports, file extraction, reconciliation
# =============================================================================

# [REQUIRED] Event key for sending events to Inngest.
# For local dev, use: local-dev-event-key
INNGEST_EVENT_KEY="local-dev-event-key"

# [REQUIRED] Signing key for verifying Inngest requests (webhook security).
# For local dev, use: local-dev-signing-key
INNGEST_SIGNING_KEY="local-dev-signing-key"


# =============================================================================
# SECURITY & RATE LIMITING — Arcjet
# =============================================================================
#
# Where to get it:
#   1. Go to https://arcjet.com (sign up / log in)
#   2. Click "Add Site" and enter your app URL
#   3. Copy the site key shown in the "SDK Installation" section
#   Free tier available with generous limits.
#
# Used in: application firewall, bot detection, rate limiting, signup
# protection across Arcjet instances.
# =============================================================================

# [REQUIRED] Arcjet site key for bot detection, rate limiting, and shield.
ARCJET_KEY=""


# =============================================================================
# RESEARCH APIs — OpenAlex & Crossref
# =============================================================================
#
# Where to get it:
#   OpenAlex and Crossref are open scholarly indexes and do not require API
#   keys for basic use. OpenAlex accepts an optional mailto parameter for
#   higher rate limits; Crossref is rate-limited by politeness pool.
#
# Used in: verified scholarly publication search, DOI verification,
#          deterministic APA 7 / Harvard citation generation.
# =============================================================================

# [OPTIONAL] OpenAlex polite pool email (optional, raises rate limits).
# OPENAX_EMAIL="research@your-institution.edu"


# =============================================================================
# PUBLIC APP URLS
# =============================================================================
#
# These are exposed to the browser (NEXT_PUBLIC_ prefix) and used for
# constructing URLs in emails, webhook setup, and client-side API calls.
# =============================================================================

# [PUBLIC][REQUIRED] The base URL of your application.
# Used for constructing email links, webhook URLs, and auth callback URLs.
# For local dev: http://localhost:3000
# For production: https://your-domain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"
