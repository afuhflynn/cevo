{
  "name": "cevo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma contract emit && next build",
    "start": "next start",
    "dev:clear": "rm -rf .next && pnpm dev",
    "dev:debug": "next dev --debug",
    "db:generate": "prisma contract emit",
    "db:validate": "prisma contract emit",
    "db:push": "prisma db push",
    "db:push:force": "prisma db push --force-reset",
    "db:push:reset": "prisma db push --force-reset",
    "db:studio": "prisma studio",
    "db:seed": "tsx scripts/seed-institutions.ts",
    "db:migrate": "prisma contract emit && prisma migration plan --name init && prisma db migrate --advance-ref db",
    "db:migrate:deploy": "prisma db migrate",
    "db:migrate:reset": "prisma migrate reset",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "clean": "rm -rf .next node_modules/.cache",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@arcjet/next": "^1.15.0",
    "@base-ui/react": "^1.9.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-query": "^5.107.1",
    "@tiptap/core": "^3.33.1",
    "@tiptap/extension-bubble-menu": "^3.33.1",
    "@tiptap/extension-link": "^3.33.1",
    "@tiptap/extension-placeholder": "^3.33.1",
    "@tiptap/extension-table": "^3.33.1",
    "@tiptap/extension-table-cell": "^3.33.1",
    "@tiptap/extension-table-header": "^3.33.1",
    "@tiptap/extension-table-row": "^3.33.1",
    "@tiptap/extension-task-item": "^3.33.1",
    "@tiptap/extension-task-list": "^3.33.1",
    "@tiptap/extension-text-align": "^3.33.1",
    "@tiptap/extension-underline": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "@vercel/speed-insights": "^2.1.0",
    "ai": "^7.0.170",
    "argon2": "^0.45.2",
    "better-auth": "^1.7.18",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.5.0",
    "nuqs": "^2.10.3",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.18.1",
    "recharts": "3.8.0",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@playwright/test": "^1.65.0",
    "@prisma/orm-postgres": "8.0.0-rc.23",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^18.0.10",
    "jsdom": "^31.0.0",
    "prisma": "8.0.0-rc.33",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.9.0"
}
